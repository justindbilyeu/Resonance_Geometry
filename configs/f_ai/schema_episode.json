{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/justindbilyeu/Resonance_Geometry/schemas/episode.json",
  "title": "Episode",
  "description": "Schema for F_AI episode data in JSONL format",
  "type": "object",
  "required": ["session_id", "episode_id", "topology_id", "messages"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique identifier for the session",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "episode_id": {
      "type": "integer",
      "description": "Episode number within session (1-indexed)",
      "minimum": 1
    },
    "topology_id": {
      "type": "string",
      "description": "Topology identifier (must exist in topology_configs.json)",
      "enum": ["role_split_BSIM", "role_split_BSI", "unified"]
    },
    "messages": {
      "type": "array",
      "description": "List of messages in the episode",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": {
            "type": "string",
            "description": "Role identifier",
            "enum": ["U", "B", "S", "I", "M", "A"]
          },
          "text": {
            "type": "string",
            "description": "Message content",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "description": "Optional ISO 8601 timestamp",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "description": "Optional metadata for the message"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional episode-level metadata"
    }
  },
  "validation_rules": {
    "required_roles": {
      "role_split_BSIM": ["U", "B", "S", "I"],
      "role_split_BSI": ["U", "B", "S", "I"],
      "unified": ["U", "A"]
    },
    "optional_roles": {
      "role_split_BSIM": ["M"],
      "role_split_BSI": [],
      "unified": []
    }
  }
}
